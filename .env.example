# Optional lazy per-clip translation. Without a key, authored target captions are used when present.
GEMINI_API_KEY=
SPEECH_RETRIEVAL_TRANSLATION_MODEL=gemini-3.1-flash-lite
SPEECH_RETRIEVAL_TRANSLATION_TARGET_LANGUAGES=en,ru
SPEECH_RETRIEVAL_DEFAULT_TARGET_LANGUAGE=en
SPEECH_RETRIEVAL_TRANSLATION_CONCURRENCY=4
SPEECH_RETRIEVAL_TRANSLATION_TIMEOUT_SECONDS=30

# Optional audio acquisition. Disabled by default; the subtitle-only quick start never
# downloads media. Enabling it requires ffmpeg and ffprobe and an operator-assessed legal
# basis for downloading and locally retaining each source.
SPEECH_RETRIEVAL_WITH_AUDIO=false
SPEECH_RETRIEVAL_FFMPEG_PATH=ffmpeg
SPEECH_RETRIEVAL_FFPROBE_PATH=ffprobe
