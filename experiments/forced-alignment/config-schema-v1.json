        },
        "max_clip_seconds": {
          "default": 20.0,
          "title": "Max Clip Seconds",
          "type": "number"
        },
        "review_clips": {
          "default": 20,
          "title": "Review Clips",
          "type": "integer"
        },
        "review_repeats": {
          "default": 3,
          "title": "Review Repeats",
          "type": "integer"
        },
        "seed": {
          "default": 20260908,
